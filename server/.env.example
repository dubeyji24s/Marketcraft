# ---- Firebase Authentication -------------------------------------------
# Your Firebase project ID (Firebase console → Project settings).
FIREBASE_PROJECT_ID=
# Comma-separated emails that get the Admin role (email must be verified).
ADMIN_EMAILS=
# Optional: path to a service-account JSON file. Enables rejecting revoked tokens.
# Keep this file OUT of git. Not needed for basic sign-in.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# Local development only: use the Firebase Auth emulator
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- AI (Claude) ---------------------------------------------------------
# Required for AI research, interview summaries and AI pitch evaluation.
# Without it the app still runs; the evaluator falls back to an offline demo scorer.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ---- Ambassador Program ---------------------------------------------
# Partner website (ambassadors log in there with the same Firebase account).
# Learners only see the public label set in Admin → Company brief.
COMPANY_NAME=
COMPANY_URL=

# ---- Server --------------------------------------------------------------
# Required in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Scoring thresholds (percent)
PASS_THRESHOLD=85
DISTINCTION_THRESHOLD=95
MAX_VIDEO_MB=200

# Comma-separated allow-list for the research engine
# RESEARCH_DOMAINS=sba.gov,ftc.gov,score.org,hbr.org
